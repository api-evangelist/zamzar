{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zamzar Account API",
    "version": "0.0.7"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve account information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zamzar.com/v1/account"
          },
          "docs": "Retrieve your account and plan information, including the number of production and test credits remaining for the current billing period."
        }
      ]
    }
  ],
  "bundled": true
}